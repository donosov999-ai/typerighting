{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeRIGHTing",
  "version": "2.56.3",
  "identifier": "com.odv999.typerighting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8006",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TypeRIGHTing — тренажёр слепой печати",
        "width": 1080,
        "height": 940,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self'; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Denis Onosov (ODV999)",
    "copyright": "© 2026 Denis Onosov (ODV999). typefree.pro",
    "homepage": "https://typefree.pro",
    "category": "Education",
    "shortDescription": "Touch typing trainer (English + Russian)",
    "longDescription": "TypeRIGHTing 2.0 — touch typing trainer with 4800+ exercises in 4 banks: words in sentences, EN-RU with translation hints, letter-by-letter buildup, poems by stanza. Migrated from the original .NET WinForms app to web + Tauri.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
